# =============================================================================
# SECRETOS de producción. Copia este fichero como "secrets.env" EN EL SERVIDOR
# (nunca en tu ordenador ni en git: .gitignore ya ignora *.env) y rellénalo.
#
#   cp secrets.env.example secrets.env && chmod 600 secrets.env
#
# Los que dicen "(auto)" puedes dejarlos VACÍOS: deploy.sh genera un valor
# aleatorio fuerte la primera vez y lo escribe aquí (para que no cambie en el
# siguiente despliegue). Los demás los sacas tú de cada web (ver
# docs/guia-produccion.md). NUNCA pegues estos valores en un chat.
# =============================================================================

# --- Base de datos y caché (auto) ---
POSTGRES_USER=nomad
POSTGRES_DB=nomadiq
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Kafka (auto): identificador del clúster ---
KAFKA_CLUSTER_ID=

# --- Notificaciones push (auto): dos claves distintas de 32 bytes ---
NOTIFY_PSEUDONYM_KEY=
NOTIFY_TOKEN_KEY=
# Firebase: el "Project ID" de tu proyecto (plan Spark, gratis). Opcional:
# sin él (y sin /etc/nomadiq/fcm.json) se despliega sin avisos push.
FCM_PROJECT_ID=

# --- Contraseña del almacén de certificados de Java (auto) ---
JAVA_TRUSTSTORE_PASSWORD=

# --- Precios de vuelos (Travelpayouts) ---
# El token SOLO viaja en una cabecera; nunca en URLs ni logs.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- Opcionales: si los dejas vacíos, esa función se apaga sola ---
MAPILLARY_TOKEN=
TICKETMASTER_API_KEY=
# Fotos de Google Maps de cada tienda en "Cerca de ti" (Places API (New) de
# Google Cloud). Ponla con: sudo infrastructure/production/poner-clave.sh GOOGLE_PLACES_API_KEY
GOOGLE_PLACES_API_KEY=
# Vídeos cortos de planes ("¿No se te ocurren planes?") de YouTube Shorts:
# clave GRATIS de YouTube Data API v3 (Google Cloud → APIs y servicios →
# Credenciales). Ponla con: sudo infrastructure/production/poner-clave.sh YOUTUBE_API_KEY
YOUTUBE_API_KEY=
# IA de Flyra (el chat), el traductor de cartas y "copia este viaje" cuando
# no cabe Ollama en el servidor: clave GRATIS de Google AI Studio
# (aistudio.google.com → "Get API key"). Ponla con:
#   sudo infrastructure/production/poner-clave.sh GEMINI_API_KEY
GEMINI_API_KEY=

# --- Copias de seguridad cifradas (Oracle Object Storage, 20 GB gratis) ---
# Endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_BUCKET=nomadiq-backups
# Si las copias van a Azure (BACKUP_PROVIDER=azure en config.env), en vez de
# las cuatro de arriba: la cuenta de almacenamiento y su clave (las rellena
# solo infrastructure/azure/crear-servidor.sh). BACKUP_BUCKET es el contenedor.
BACKUP_AZURE_ACCOUNT=
BACKUP_AZURE_KEY=
# Contraseña con la que se cifran las copias (auto). ¡GUÁRDALA también fuera
# del servidor (gestor de contraseñas)! Sin ella no se puede restaurar nada.
BACKUP_PASSPHRASE=

# --- Avisos al móvil (app ntfy, gratis) ---
# https://ntfy.sh/<un-nombre-largo-y-secreto-que-solo-sepas-tú>
NTFY_URL=
