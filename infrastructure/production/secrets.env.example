# =============================================================================
# SECRETOS de producción. Copia este fichero como "secrets.env" EN EL SERVIDOR
# (nunca en tu ordenador ni en git: .gitignore ya ignora *.env) y rellénalo.
#
#   cp secrets.env.example secrets.env && chmod 600 secrets.env
#
# Los que dicen "(auto)" puedes dejarlos VACÍOS: deploy.sh genera un valor
# aleatorio fuerte la primera vez y lo escribe aquí (para que no cambie en el
# siguiente despliegue). Los demás los sacas tú de cada web (ver
# docs/guia-produccion.md). NUNCA pegues estos valores en un chat.
# =============================================================================

# --- Base de datos y caché (auto) ---
POSTGRES_USER=nomad
POSTGRES_DB=nomadiq
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Kafka (auto): identificador del clúster ---
KAFKA_CLUSTER_ID=

# --- Notificaciones push (auto): dos claves distintas de 32 bytes ---
NOTIFY_PSEUDONYM_KEY=
NOTIFY_TOKEN_KEY=
# Firebase: el "Project ID" de tu proyecto (plan Spark, gratis).
FCM_PROJECT_ID=

# --- Contraseña del almacén de certificados de Java (auto) ---
JAVA_TRUSTSTORE_PASSWORD=

# --- Precios de vuelos (Travelpayouts) ---
# El token SOLO viaja en una cabecera; nunca en URLs ni logs.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- Opcionales: si los dejas vacíos, esa función se apaga sola ---
MAPILLARY_TOKEN=
TICKETMASTER_API_KEY=

# --- Copias de seguridad cifradas (Oracle Object Storage, 20 GB gratis) ---
# Endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_BUCKET=nomadiq-backups
# Contraseña con la que se cifran las copias (auto). ¡GUÁRDALA también fuera
# del servidor (gestor de contraseñas)! Sin ella no se puede restaurar nada.
BACKUP_PASSPHRASE=

# --- Avisos al móvil (app ntfy, gratis) ---
# https://ntfy.sh/<un-nombre-largo-y-secreto-que-solo-sepas-tú>
NTFY_URL=
