# =============================================================================
# Configuración NO secreta de producción. Copia como "config.env" en el
# servidor y rellena. (Tampoco va a git: *.env está ignorado.)
# =============================================================================

# Tu dominio (p. ej. el gratis de DuckDNS: minomadiq.duckdns.org). Let's
# Encrypt pedirá el certificado https para este nombre.
DOMAIN=

# Correo para Let's Encrypt (te avisa si un certificado fuera a caducar).
ACME_EMAIL=

# Modelo de IA local. En el servidor gratis (2 núcleos ARM, sin tarjeta
# gráfica) uno pequeño responde en segundos; uno grande tardaría minutos.
OLLAMA_MODEL=llama3.2:3b

# Rutas que se vigilan siempre aunque nadie las siga (origen-destino, comas).
POPULAR_ROUTES=MAD-BCN,MAD-LIS,MAD-CDG,BCN-LHR,MAD-JFK

# Login con Google: el "Client ID" de tipo Web de Google Cloud Console
# (no es un secreto). Vacío = el botón de Google responde que no está activado.
GOOGLE_CLIENT_ID=

# IA local (Ollama) para Flyra, las audioguías y los planes. Necesita un
# servidor de 12 GB o más. En uno de 8 GB pon false: Flyra contesta con reglas
# sencillas y todo lo demás funciona igual.
LLM_ENABLED=true

# Dónde se guardan las copias de seguridad cifradas: oci (Oracle Object
# Storage) o azure (Azure Blob Storage). Cada uno usa sus claves de secrets.env.
BACKUP_PROVIDER=oci
