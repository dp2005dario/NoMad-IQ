# Copia este fichero a ".env" (está ignorado por git) y rellena cada valor.
# Genera contraseñas robustas con:   openssl rand -base64 32
# docker compose se niega a arrancar si falta alguna variable obligatoria.

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=nomadiq
POSTGRES_DB=nomadiq
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Qdrant (base de datos vectorial) ---
QDRANT_API_KEY=

# --- Kafka (KRaft) ---
# Identificador único del clúster. Genera uno con:
#   docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=

# --- flight-ingestor (opcionales, solo desarrollo) ---
# POLL_INTERVAL=1m
# SEED_WATCHES=MAD-NRT:2026-12-01:ECONOMY,BCN-JFK:2026-12-10:2026-12-20:BUSINESS
