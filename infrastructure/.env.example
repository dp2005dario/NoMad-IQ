# Copia este fichero a ".env" (está ignorado por git) y rellena cada valor.
# Genera contraseñas robustas con:   openssl rand -base64 32
# docker compose se niega a arrancar si falta alguna variable obligatoria.

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=nomadiq
POSTGRES_DB=nomadiq
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Qdrant (base de datos vectorial) ---
QDRANT_API_KEY=

# --- Kafka (KRaft) ---
# Identificador único del clúster. Genera uno con:
#   docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=

# --- Notificaciones push (geo-engine + notifier) ---
# Dos claves DISTINTAS de 32 bytes en hexadecimal. "make keys" las crea y las
# añade a tu .env si faltan. A mano: openssl rand -hex 32
#   NOTIFY_PSEUDONYM_KEY: calcula el seudónimo de cada persona (la comparten
#                         el geo-engine y el notifier).
#   NOTIFY_TOKEN_KEY:     cifra los tokens de FCM guardados (solo el notifier).
NOTIFY_PSEUDONYM_KEY=
NOTIFY_TOKEN_KEY=
# NOTIFY_COOLDOWN=45m

# --- flight-ingestor (opcionales, solo desarrollo) ---
# POLL_INTERVAL=1m
# SEED_WATCHES=MAD-NRT:2026-12-01:ECONOMY,BCN-JFK:2026-12-10:2026-12-20:BUSINESS
# SIMULATED_ERROR_FARE_RATE=0.2

# --- flight-ingestor: precios REALES (opcional) ---
# Sin esto se usan precios inventados. Cómo conseguir el token y el marker:
# docs/guia-travelpayouts.md. El token es SECRETO: nunca lo subas a GitHub
# (.env está en .gitignore, este .env.example no lleva valores reales).
# FARE_PROVIDER=travelpayouts
# TRAVELPAYOUTS_TOKEN=
# TRAVELPAYOUTS_MARKER=
# TRAVELPAYOUTS_CURRENCY=EUR

# --- ai-orchestrator: fotos reales de la calle (opcional) ---
# Token gratuita de Mapillary ("Client Token", empieza por MLY|): se crea en
# https://www.mapillary.com/dashboard/developers. Es SECRETA: solo aquí, en
# .env, nunca en GitHub. Sin ella, el botón "Ver la calle de verdad" no sale.
# MAPILLARY_TOKEN=

# --- ai-orchestrator: eventos de la ciudad (opcional) ---
# Clave gratuita de Ticketmaster ("Consumer Key"): se crea en
# https://developer.ticketmaster.com. Es SECRETA: solo aquí, en .env, nunca
# en GitHub. Sin ella, "Qué pasa en tus fechas" enseña solo los festivos.
# TICKETMASTER_API_KEY=

# --- price-consumer (opcionales, solo desarrollo) ---
# Formato: usuario|CLAVE_DE_RUTA[|precio_objetivo_en_centimos|DIVISA], separadas por comas.
# SEED_SUBSCRIPTIONS=dario|MAD-NRT:2026-12-01:ECONOMY,dario|BCN-JFK:2026-12-10:2026-12-20:BUSINESS|90000|EUR

# --- auth-gateway (opcionales, solo desarrollo) ---
# Límites de peticiones (formato peticiones/ventana: 10/1m, 5/15m, 100/1h).
# RATE_LIMIT_LOGIN_IP=20/1m
# RATE_LIMIT_LOGIN_FAILURES=5/15m
# ACCESS_TOKEN_TTL=15m

# --- ai-orchestrator (opcionales, solo desarrollo) ---
# Modelo de Ollama (descárgalo con "make ollama"). LLM_ENABLED=false = todo por reglas.
# OLLAMA_MODEL=llama3.1:8b
# LLM_ENABLED=true
