<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Hablar con el backend (inicio de sesión, vuelos, mapa...). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ubicación. FINE = GPS preciso; COARSE = aproximada (Android 12+ deja
         al usuario elegir "aproximada", y la app sigue funcionando). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- "Modo viaje": la ubicación sigue con la app cerrada gracias a un
         "servicio en primer plano" con una notificación fija que lo dice.
         Como el usuario lo enciende con la app abierta, basta el permiso
         "mientras se usa la app": NO pedimos ACCESS_BACKGROUND_LOCATION
         (que exige un formulario aparte en Google Play). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+: permiso para enseñar notificaciones (avisos push y la
         notificación fija del modo viaje). Se pide al encender el modo viaje. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Modo cámara: solo fotos para reconocer monumentos. El paquete de la
         cámara también pide micrófono y escribir en la memoria (para vídeo);
         como no los usamos, los quitamos (tools:node="remove"). Y la cámara
         no es obligatoria: la app se instala también en aparatos sin ella. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- allowBackup="false": la sesión cifrada no debe copiarse a la nube ni a
         otro móvil (su clave vive en el chip del teléfono y no viajaría). -->
    <application
        android:allowBackup="false"
        android:label="NomadIQ"
        android:localeConfig="@xml/locales_config"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Abrir la web de reserva de un vuelo en el navegador (url_launcher). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- La voz del móvil (texto a voz) para "Escuchar" en el modo cámara. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
