<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Hablar con el backend (inicio de sesión, vuelos, mapa...). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ubicación. FINE = GPS preciso; COARSE = aproximada (Android 12+ deja
         al usuario elegir "aproximada", y la app sigue funcionando). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- "Modo viaje": la ubicación sigue con la app cerrada gracias a un
         "servicio en primer plano" con una notificación fija que lo dice.
         Como el usuario lo enciende con la app abierta, basta el permiso
         "mientras se usa la app": NO pedimos ACCESS_BACKGROUND_LOCATION
         (que exige un formulario aparte en Google Play). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Audioguías con el móvil bloqueado: otro servicio en primer plano, de
         tipo "reproducción multimedia", y que la CPU no se duerma mientras
         suena (WAKE_LOCK). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+: permiso para enseñar notificaciones (avisos push y la
         notificación fija del modo viaje). Se pide al encender el modo viaje. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para volver a programar los widgets y el aviso del vuelo tras
         reiniciar el móvil (Android borra las alarmas al apagarse). Sin
         alarmas exactas: unos minutos de margen bastan y no piden permiso. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Cámara: fotos de monumentos y la cámara de viaje de Recuerdos. El
         micrófono solo hace falta para el sonido de los vídeos de Recuerdos y
         Android lo pregunta la primera vez que pasas a VÍDEO. Escribir en la
         memoria compartida no lo usamos (los recuerdos van a la carpeta
         privada de la app), así que se quita (tools:node="remove"). Y la
         cámara no es obligatoria: la app se instala en aparatos sin ella. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- allowBackup="false": la sesión cifrada no debe copiarse a la nube ni a
         otro móvil (su clave vive en el chip del teléfono y no viajaría). -->
    <application
        android:allowBackup="false"
        android:label="NomadIQ"
        android:localeConfig="@xml/locales_config"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Android Auto: somos una app de audio (ver res/xml/automotive_app_desc.xml). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- El servicio de audio de just_audio_background (paquete
             audio_service) y quien recibe los botones de los auriculares. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <!-- Widgets del escritorio (NomadWidgets.kt). -->
        <receiver android:name=".FlightWidget" android:label="@string/widget_flight_name" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/nomad_widget_flight" />
        </receiver>
        <receiver android:name=".DealWidget" android:label="@string/widget_deal_name" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/nomad_widget_deal" />
        </receiver>
        <receiver android:name=".BudgetWidget" android:label="@string/widget_budget_name" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/nomad_widget_budget" />
        </receiver>
        <!-- Despierta los widgets a las horas que dejó la app (embarque,
             despegue, llegada...) y vuelve a armar esas horas al reiniciar. -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetScheduledUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- El aviso "en directo" del día del vuelo: se programa en el móvil
             (sin servidor) y estos dos lo enseñan a su hora y tras reiniciar. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Abrir la web de reserva de un vuelo en el navegador (url_launcher). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Oír lo que dices en el Asistente (reconocimiento de voz del sistema). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- La voz del móvil (texto a voz) para "Escuchar" en el modo cámara. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
