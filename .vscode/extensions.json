{
  // Extensiones que VS Code te ofrecerá instalar al abrir esta carpeta
  // (aparece un aviso abajo a la derecha: pulsa "Instalar todas").
  "recommendations": [
    "golang.go",                          // Go: autocompletado, errores al escribir, tests y depurador
    "vscjava.vscode-java-pack",           // Java: compilar, autocompletar, tests JUnit y depurador (auth-gateway)
    "vmware.vscode-boot-dev-pack",        // Spring Boot: autocompletado de application.yaml y panel de la app
    "ms-azuretools.vscode-docker",        // Docker: ver contenedores, logs y docker-compose
    "ms-python.python",                   // Python: autocompletado, depurador y tests con pytest (ai-orchestrator)
    "charliermarsh.ruff",                 // Ruff: formatea y revisa el Python al guardar (igual que la CI)
    "ms-python.mypy-type-checker",        // mypy: marca en rojo los errores de tipos mientras escribes
    "bufbuild.vscode-buf",                // Protobuf: resaltado y validación de los .proto con buf
    "redhat.vscode-yaml",                 // YAML: valida docker-compose.yml y la CI de GitHub
    "github.vscode-github-actions",       // GitHub Actions: ver la CI sin salir del editor
    "ckolkman.vscode-postgres",           // PostgreSQL: explorar tablas y lanzar consultas
    "yzhang.markdown-all-in-one"          // Markdown: vista previa cómoda de las guías de docs/
  ]
}
