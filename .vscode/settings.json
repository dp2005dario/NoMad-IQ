{
  // Ajustes compartidos del proyecto para VS Code.
  // Formatea Go al guardar (igual que exige la CI con gofmt).
  "[go]": {
    "editor.formatOnSave": true
  },
  // Que el editor también entienda los tests de integración (etiqueta "integration").
  "gopls": {
    "buildFlags": ["-tags=integration"]
  },
  // Los tests unitarios se ejecutan con el detector de carreras.
  "go.testFlags": ["-race", "-count=1"],
  // Java: cuando cambias el pom.xml, VS Code recarga las librerías él solo.
  "java.configuration.updateBuildConfiguration": "automatic",
  // Python (ai-orchestrator): usa el entorno que crea "uv sync" y formatea con ruff al guardar.
  // En Windows, si no lo detecta: Ctrl+Shift+P > "Python: Select Interpreter" > services/ai-orchestrator/.venv/Scripts/python.exe
  "python.defaultInterpreterPath": "${workspaceFolder}/services/ai-orchestrator/.venv/bin/python",
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  // Tests de Python desde el panel de pruebas (el icono del matraz).
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/services/ai-orchestrator",
  "python.testing.pytestArgs": ["tests"],
  // Rust (geo-engine): rust-analyzer busca un Cargo.toml en la raíz de la carpeta
  // abierta; el nuestro está en services/geo-engine, así que se lo indicamos.
  "rust-analyzer.linkedProjects": ["services/geo-engine/Cargo.toml"],
  // Al guardar, revisa con clippy (igual que la CI) y formatea con rustfmt.
  "rust-analyzer.check.command": "clippy",
  "[rust]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  // El código generado no se edita: lo marcamos como solo lectura.
  "files.readonlyInclude": {
    "gen/**": true,
    "services/ai-orchestrator/src/nomadiq/**": true
  }
}
